{
  "name": "exo-shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./api": {
      "types": "./src/api.d.ts",
      "default": "./src/api.js"
    },
    "./auth": "./src/auth.js",
    "./models": {
      "types": "./src/models.d.ts",
      "default": "./src/models.js"
    },
    "./endpoints/*": "./src/endpoints/*",
    "./hooks/useApi": "./src/hooks/useApi.js",
    "./hooks/useCsrf": "./src/hooks/useCsrf.js",
    "./styles/base.css": "./src/styles/base.css",
    "./styles/transitions.css": "./src/styles/transitions.css",
    "./profile": {
      "types": "./src/profile.d.ts",
      "default": "./src/profile.js"
    },
    "./hooks/useProfile": "./src/hooks/useProfile.js",
    "./hooks/useFont": {
      "types": "./src/hooks/useFont.d.ts",
      "default": "./src/hooks/useFont.js"
    },
    "./hooks/useTheme": {
      "types": "./src/hooks/useTheme.d.ts",
      "default": "./src/hooks/useTheme.js"
    },
    "./utils/avatar": "./src/utils/avatar.js",
    "./styles/fonts.css": "./src/styles/fonts.css"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
